# Paper Harness v1 environment configuration.
#
# Copy this file to `.env` and edit the values for your machine:
#
#   cp .env.example .env
#
# `.env` is untracked (see .gitignore). Never commit `.env` and never commit
# real credentials. Treat every API key below as a secret.

# ---------------------------------------------------------------------------
# Host-side paths (read by Docker Compose on the host)
# ---------------------------------------------------------------------------

# Absolute path on the Docker host that backs the container's /data volume.
# This is where all mutable Library state lives and what you should back up.
# Example: /Users/you/paper-harness-data or /srv/paper-harness-data
# The container runs as uid/gid 1000, so this directory must be writable by
# that uid (on Docker Desktop for macOS/Windows this is handled for you).
PAPER_HARNESS_HOST_DATA_DIR=/absolute/path/to/paper-harness-data

# ---------------------------------------------------------------------------
# Container runtime (read by the application inside the container)
# ---------------------------------------------------------------------------

# Root directory for all mutable data. Inside Docker this is the mounted volume.
PAPER_HARNESS_DATA_ROOT=/data

# Direct Node startup defaults to loopback. Compose sets 0.0.0.0 inside the
# container and publishes only on host loopback.
PAPER_HARNESS_HOST=127.0.0.1

# TCP port the HTTP server listens on.
PAPER_HARNESS_PORT=8787

# ---------------------------------------------------------------------------
# LLM provider
# ---------------------------------------------------------------------------

# `fake`  - deterministic, offline provider for development and tests.
# `opencode-go` - remote OpenAI-compatible provider (sends relevant Paper
#                 content and Paper Notes to the configured service).
LLM_PROVIDER=fake

# Required when LLM_PROVIDER=opencode-go. Leave empty for `fake`.
OPENCODE_GO_API_KEY=

# Base URL of the OpenAI-compatible service.
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/v1

# Model identifier. Defaults to deepseek-v4.1-flash.
OPENCODE_GO_MODEL=deepseek-v4.1-flash

# Header used to propagate the conversation session id to the provider.
OPENCODE_GO_SESSION_HEADER=x-session-id

# ---------------------------------------------------------------------------
# PDF extraction limits
# ---------------------------------------------------------------------------

# Maximum accepted PDF size in bytes (default 10 MiB).
PDF_MAX_BYTES=10485760

# Maximum pages read from a single PDF (default 50).
PDF_MAX_PAGES=50

# Maximum extracted characters per PDF read (default 200000).
PDF_MAX_CHARS=200000

# ---------------------------------------------------------------------------
# Upload staging limits
# ---------------------------------------------------------------------------

# Maximum staged upload size in bytes (default 100 MiB).
UPLOAD_MAX_BYTES=104857600

# Hours before an unused staged upload is purged (default 24).
UPLOAD_TTL_HOURS=24

# ---------------------------------------------------------------------------
# HTTP body limits
# ---------------------------------------------------------------------------

# Maximum JSON request body size in bytes (default 1 MiB).
JSON_BODY_MAX_BYTES=1048576

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# Application log level (for example: debug, info, warn, error).
PAPER_HARNESS_LOG_LEVEL=info
