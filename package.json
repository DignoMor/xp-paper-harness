{
  "name": "paper-harness",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local-first personal environment for managing academic Papers, Attachments, and Paper Notes.",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-browser.mjs",
    "build:server": "tsc -p tsconfig.json",
    "build:browser": "node scripts/build-browser.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/main.js",
    "reconcile": "node dist/cli/reconcile.js",
    "dev": "tsx src/main.ts"
  },
  "dependencies": {
    "cordis": "^4.0.0-rc.10",
    "js-yaml": "^4.1.0",
    "marked": "^15.0.0",
    "pdfjs-dist": "^4.10.38"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
